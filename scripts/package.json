{
  "name": "@workspace/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "hello": "tsx ./src/hello.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsx ./src/check-permissions.ts && tsx ./src/audit-route-guards.ts",
    "permissions": "tsx ./src/check-permissions.ts",
    "permissions:write": "tsx ./src/check-permissions.ts --write",
    "audit:guards": "tsx ./src/audit-route-guards.ts",
    "audit:guards:write": "tsx ./src/audit-route-guards.ts --write"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:"
  }
}
